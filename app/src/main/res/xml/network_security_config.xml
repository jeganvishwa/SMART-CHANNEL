<?xml version="1.0" encoding="utf-8"?>
<!--
  Many free-to-air IPTV playlists and streams are still served over plain HTTP,
  and the URLs are entered by the user, so cleartext must be allowed.
  The app never sends credentials of its own; HTTPS is used whenever the URL uses it.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
